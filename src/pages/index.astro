---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Marizu-Dominic | Home" description="Welcome to our beautiful website">
  <section class="hero">
    <div class="hero-content">
      <h1>Welcome to Marizu-Dominic</h1>
      <p>Convert your HTML/CSS designs into a powerful Astro website</p>
      <button class="cta-button">Get Started</button>
    </div>
  </section>

  <section class="features">
    <h2>Our Features</h2>
    <div class="features-grid">
      <div class="feature-card">
        <h3>⚡ Fast</h3>
        <p>Lightning-fast performance with Astro's static generation</p>
      </div>
      <div class="feature-card">
        <h3>🎨 Beautiful</h3>
        <p>Stunning designs with responsive CSS</p>
      </div>
      <div class="feature-card">
        <h3>🔧 Easy</h3>
        <p>Simple component-based architecture</p>
      </div>
    </div>
  </section>
</Layout>

<style>
  .hero {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
    padding: 6rem 2rem;
    text-align: center;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 60vh;
  }

  .hero-content h1 {
    font-size: 3rem;
    margin-bottom: 1rem;
    font-weight: 700;
  }

  .hero-content p {
    font-size: 1.25rem;
    margin-bottom: 2rem;
    opacity: 0.95;
  }

  .cta-button {
    background: white;
    color: #667eea;
    padding: 0.75rem 2rem;
    font-size: 1rem;
    border: none;
    border-radius: 50px;
    cursor: pointer;
    font-weight: 600;
    transition: transform 0.3s ease;
  }

  .cta-button:hover {
    transform: scale(1.05);
  }

  .features {
    padding: 4rem 2rem;
    max-width: 1200px;
    margin: 0 auto;
  }

  .features h2 {
    text-align: center;
    font-size: 2.5rem;
    margin-bottom: 3rem;
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
  }

  .feature-card {
    padding: 2rem;
    border-radius: 8px;
    background: #f8f9fa;
    text-align: center;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    transition: transform 0.3s ease;
  }

  .feature-card:hover {
    transform: translateY(-5px);
  }

  .feature-card h3 {
    font-size: 1.5rem;
    margin-bottom: 1rem;
  }

  @media (max-width: 768px) {
    .hero-content h1 {
      font-size: 2rem;
    }

    .features h2 {
      font-size: 1.8rem;
    }
  }
</style>