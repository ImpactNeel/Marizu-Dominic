---
// Import components
import Header from '../components/Header.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';

// Import global styles
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = '100th Law | Precision in Practice' } = Astro.props;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,200..800;1,6..72,200..800&family=Inter:wght@100..900&display=swap" rel="stylesheet"/>
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>
  </head>
  <body class="bg-surface text-on-background">
    <Navigation />
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style is:global>
  :root {
    --material-symbols-outlined-font-variation: 'FILL' 0, 'wght' 300, 'GRAD' 0, 'opsz' 24;
  }
  .material-symbols-outlined {
    font-variation-settings: var(--material-symbols-outlined-font-variation);
  }
</style>