---
// Footer component
---

<footer class="bg-slate-950 px-16 py-24 w-full grid grid-cols-1 md:grid-cols-4 gap-12 border-t border-slate-800/20">
  <div class="col-span-1">
    <div class="font-headline text-xl text-slate-100 mb-6">100th Law</div>
    <p class="text-slate-500 font-body text-sm leading-relaxed">Providing high-stakes litigation services globally. Precision is not just a standard; it is our foundation.</p>
  </div>
  <div class="col-span-1">
    <h5 class="text-slate-100 font-bold uppercase text-xs tracking-[0.2em] mb-6 font-body">Navigation</h5>
    <ul class="space-y-4 font-body text-sm tracking-wide ml-0 list-none">
      <li><a class="text-slate-500 hover:text-slate-300 transition-colors" href="#">Practice Areas</a></li>
      <li><a class="text-slate-500 hover:text-slate-300 transition-colors" href="#">Our Results</a></li>
      <li><a class="text-slate-500 hover:text-slate-300 transition-colors" href="#">Partner Biographies</a></li>
      <li><a class="text-slate-500 hover:text-slate-300 transition-colors" href="#">Global Operations</a></li>
    </ul>
  </div>
  <div class="col-span-1">
    <h5 class="text-slate-100 font-bold uppercase text-xs tracking-[0.2em] mb-6 font-body">Legal</h5>
    <ul class="space-y-4 font-body text-sm tracking-wide ml-0 list-none">
      <li><a class="text-slate-500 hover:text-slate-300 transition-colors" href="#">Privacy Policy</a></li>
      <li><a class="text-slate-500 hover:text-slate-300 transition-colors" href="#">Terms of Service</a></li>
      <li><a class="text-slate-500 hover:text-slate-300 transition-colors" href="#">Disclaimer</a></li>
      <li><a class="text-slate-500 hover:text-slate-300 transition-colors" href="#">Sitemap</a></li>
    </ul>
  </div>
  <div class="col-span-1">
    <h5 class="text-slate-100 font-bold uppercase text-xs tracking-[0.2em] mb-6 font-body">Newsletter</h5>
    <div class="relative">
      <input
        class="w-full bg-slate-900 border-b-2 border-slate-700 focus:border-primary px-4 py-3 text-sm text-slate-300 outline-none transition-colors"
        placeholder="Email Address"
        type="email"
      />
      <button class="absolute right-0 top-1/2 -translate-y-1/2 text-primary p-0 bg-transparent hover:shadow-none hover:translate-y-[-50%]">
        <span class="material-symbols-outlined">chevron_right</span>
      </button>
    </div>
    <p class="text-[10px] text-slate-600 mt-4 uppercase tracking-tighter">© 2024 100th Law. All rights reserved. Precision in practice.</p>
  </div>
</footer>
