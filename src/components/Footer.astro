---
// Footer component
const currentYear = new Date().getFullYear();
---

<footer class="footer">
  <div class="footer-container">
    <div class="footer-content">
      <h3>Marizu-Dominic</h3>
      <p>Converting your designs into beautiful, fast websites with Astro.</p>
    </div>
    <div class="footer-links">
      <h4>Quick Links</h4>
      <ul>
        <li><a href="/">Home</a></li>
        <li><a href="/#features">Features</a></li>
      </ul>
    </div>
    <div class="footer-social">
      <h4>Follow Us</h4>
      <div class="social-links">
        <a href="#" aria-label="GitHub">GitHub</a>
        <a href="#" aria-label="Twitter">Twitter</a>
        <a href="#" aria-label="LinkedIn">LinkedIn</a>
      </div>
    </div>
  </div>
  <div class="footer-bottom">
    <p>&copy; {currentYear} Marizu-Dominic. All rights reserved. | Built with <span class="heart">❤️</span> using Astro</p>
  </div>
</footer>

<style>
  .footer {
    background: #2d3748;
    color: #e0e0e0;
    padding: 3rem 2rem 1rem;
    margin-top: 4rem;
  }

  .footer-container {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 2rem;
    margin-bottom: 2rem;
  }

  .footer h3 {
    font-size: 1.3rem;
    margin-bottom: 1rem;
    color: #fff;
  }

  .footer h4 {
    font-size: 1rem;
    margin-bottom: 1rem;
    color: #fff;
  }

  .footer p {
    line-height: 1.8;
  }

  .footer-links ul,
  .social-links {
    list-style: none;
  }

  .footer-links ul li,
  .social-links a {
    margin-bottom: 0.5rem;
  }

  .footer-links a,
  .social-links a {
    text-decoration: none;
    color: #e0e0e0;
    transition: color 0.3s ease;
  }

  .footer-links a:hover,
  .social-links a:hover {
    color: #667eea;
  }

  .footer-bottom {
    border-top: 1px solid #444;
    padding-top: 1rem;
    text-align: center;
    font-size: 0.9rem;
  }

  .heart {
    display: inline-block;
    animation: heartbeat 1s infinite;
  }

  @keyframes heartbeat {
    0%, 100% {
      transform: scale(1);
    }
    50% {
      transform: scale(1.1);
    }
  }

  @media (max-width: 768px) {
    .footer-container {
      grid-template-columns: 1fr;
    }
  }
</style>